# ==============================================
# AI Prompt Tutor — Environment Variables
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to Git!
# The .env file is already listed in .gitignore.
# ==============================================

# Groq API Key (required for Cloud API mode)
# Get yours free at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Groq Model (optional, default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# ML Service URL (optional, default: http://localhost:5000)
# Points to the local PyTorch model server (ml_models/serve.py)
ML_SERVICE_URL=http://localhost:5000

# Server Port (optional, default: 3000)
PORT=3000
